# Pesos HF baixados (manter apenas o lock)
BaseRepos/*
!BaseRepos/base-repos.lock.json

# Descartaveis
cache/
tmp/
logs/
env/.venv/
__pycache__/
*.pyc

# Pesos / artefatos binarios
*.safetensors
*.gguf
*.onnx
*.bin
*.pt

# Workspaces de modelos: conteudo de artefatos (mantem .gitkeep)
Repos/*/checkpoints/*
Repos/*/adapters/*
Repos/*/merged/*
Repos/*/gguf/*
Repos/*/exports/*
!Repos/*/*/.gitkeep

# Dados grandes / derivados
data/generated/*
data/validated/*
data/distilled/*
data/kd/*
data/calib/*
!data/*/.gitkeep

# Dumps de fixtures (mongodump --gzip; regeneraveis via seed_fixtures.py, > 5 MB)
data/fixtures/dumps/

# Conjunto cego: nunca versionado
data/eval/blind/

# Bake-off
bakeoff/v1/cache/
bakeoff/v1/tmp/

#
.vs


# v2: ids de split (> 5 MB no total)
data/splits/v2/
data/splits/v2s1/
data/splits/v2c/

# Corpus tokenizado do professor (derivado de data/validated; regeneravel com scripts/teacher/build_teacher_corpus.py)
data/teacher/*
!data/teacher/.gitkeep

# Replay de codigo generico (terceiros, licencas permissivas; fonte local; regeneravel com scripts/data/build_replay.py)
data/replay/*
!data/replay/.gitkeep
reports/gpu_queue/ALERT.txt

# Corpus tokenizado dos alunos T0/T1 (derivado de data/distilled + data/replay; regeneravel com scripts/student/build_student_corpus.py)
data/student/*
!data/student/.gitkeep
